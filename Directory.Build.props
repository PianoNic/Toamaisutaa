<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <!-- A LOCAL FALLBACK ONLY. It is not the released version and does not need to track one.
         Releases take their version from the git tag: release.yml passes -p:Version to build and
         pack, so the tag is what gets stamped into both the packages and the assemblies. Nothing
         here has to be bumped before a release, deliberately - publishing a draft creates the tag
         and starts the pipeline in one click, so any step that had to happen first is a step that
         eventually gets forgotten.

         This value only decides what a local `dotnet pack` produces. Leave it alone unless a local
         package needs a particular number. -->
    <Version>0.1.0</Version>
    <Authors>Pianonic</Authors>
    <Company>Pianonic</Company>
    <Product>Toamaisutaa</Product>
    <Copyright>Copyright (c) 2026 Pianonic</Copyright>
    <PackageProjectUrl>https://github.com/PianoNic/Toamaisutaa</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PianoNic/Toamaisutaa</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- PolyForm Noncommercial is not OSI-approved, so it cannot be expressed as a licence
         expression. The file is packed at the root instead. -->
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>authentication;oidc;openid-connect;jwt;bearer;aspnetcore;identity;login;password;efcore</PackageTags>
    <!-- Moves as a pair with the None item below: the property names the file, the item puts it in
         the package, and packing with one and not the other fails. -->
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The XML comments are where the reasoning lives, so ship them: they are what a consumer sees
         in IntelliSense. CS1591 is off because a docless public member is not worth failing a build
         over. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- The README is NOT here. Each package packs its own from its own directory, wired up in
       Directory.Build.targets - see the comment there for why it has to be a .targets file. -->

</Project>
