{
  "interactiveLogin": false,
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "client_id",
          "match": "toamaisutaa-sample",
          "claims": {
            "sub": "sample-gatekeeper",
            "name": "Tormeister",
            "preferred_username": "gatekeeper",
            "email": "gatekeeper@toamaisutaa.local",
            "email_verified": true,
            "picture": "https://api.dicebear.com/9.x/thumbs/svg?seed=gatekeeper",
            "aud": [ "toamaisutaa-sample" ],
            "roles": [ "admin" ]
          }
        },
        {
          "requestParam": "client_id",
          "match": "toamaisutaa-viewer",
          "claims": {
            "sub": "sample-visitor",
            "name": "Visitor",
            "preferred_username": "visitor",
            "email": "visitor@toamaisutaa.local",
            "email_verified": true,
            "aud": [ "toamaisutaa-sample" ]
          }
        }
      ]
    }
  ]
}
