{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Toamaisutaa": "Data Source=toamaisutaa-sample.db"
  },
  "Oidc": {
    "Authority": "http://localhost:8080/default",
    "ClientId": "toamaisutaa-sample",
    "RequireHttpsMetadata": false,
    "RoleClaim": "roles",
    "AdminRole": "admin",
    "Scope": "openid profile email roles",
    "PublicUrl": "http://localhost:5203",
    "QueryToken": {
      "IncludePaths": [ "/hubs" ]
    }
  },
  "LocalLogin": {
    "__comment": "Dev values. Never commit a real signing key or pepper; both belong in the environment.",
    "SigningKey": "dG9hbWFpc3V0YWEtc2FtcGxlLWRldi1zaWduaW5nISE=",
    "Issuer": "toamaisutaa-sample",
    "Pepper": "dG9hbWFpc3V0YWEtc2FtcGxlLWRldi1wZXBwZXIhISE=",
    "PepperVersion": "1",
    "AllowSelfRegistration": true,
    "AccessTokenLifetime": "00:15:00",
    "RateLimit": {
      "PermitLimit": 20,
      "Window": "00:01:00"
    }
  }
}
