{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Toamaisutaa": "Data Source=toamaisutaa-sample.db"
  },
  "Oidc": {
