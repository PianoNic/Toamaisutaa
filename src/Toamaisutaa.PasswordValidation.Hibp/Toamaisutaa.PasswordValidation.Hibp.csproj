<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Opt-in Have I Been Pwned breach check for Toamaisutaa password validation. Wraps the length rules rather than replacing them, asks the range API with five characters of a SHA-1 hash, and lets the password through when the service is unreachable.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Toamaisutaa.Abstractions\Toamaisutaa.Abstractions.csproj" />
    <!-- For DefaultPasswordValidator, which is what this wraps when nothing else has registered an
         IPasswordValidator yet - so the call works either side of AddToamaisutaaPasswordLogin. -->
    <ProjectReference Include="..\Toamaisutaa.Core\Toamaisutaa.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- The lookup goes over HTTP, and a singleton validator holding one HttpClient for the life of
         the process is how a rotated DNS record stops being noticed. The factory hands out a client
         per lookup and rotates the handlers underneath it. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Toamaisutaa.PasswordValidation.Hibp.Tests" />
    <InternalsVisibleTo Include="Toamaisutaa.AspNetCore.Tests" />
  </ItemGroup>
</Project>
