<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>ASP.NET Core integration for Toamaisutaa: the authenticated-by-default authorization policy, ICurrentUser, the runtime OIDC configuration endpoint a SPA reads at startup, and the local username and password sign-in endpoints.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Toamaisutaa.Core\Toamaisutaa.Core.csproj" />
    <!-- Intrinsic, not incidental. Local password login mints access tokens that only the bearer
         pipeline can validate, which is the whole point of there being one handler for both token
         shapes - so nobody can use this package's sign-in endpoints without also calling
         AddToamaisutaaBearer. Referencing it makes that requirement visible to the package graph
         instead of surfacing as a startup error naming an API the consumer has not installed. -->
    <ProjectReference Include="..\Toamaisutaa.OpenIdConnect\Toamaisutaa.OpenIdConnect.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>