<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Opt-in Argon2id password hashing for Toamaisutaa. Nothing else references this package - install it only if you want the memory-hard hash instead of the in-box PBKDF2 one, and are willing to carry the dependency it needs.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Toamaisutaa.Abstractions\Toamaisutaa.Abstractions.csproj" />
    <!-- Core, because the PBKDF2 hasher is what reads the rows a deployment already has: this
         package hashes with Argon2id and hands everything else to it, which is what makes the
         migration a rehash on next login rather than a flag day. -->
    <ProjectReference Include="..\Toamaisutaa.Core\Toamaisutaa.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!-- The one external dependency this package exists to isolate. .NET has no in-box Argon2 and
         is not getting one, so a memory-hard hash means someone else's implementation; Konscious is
         pure managed with no native assets, passes the RFC 9106 vectors, and carries no advisories.
         It is kept out of Core deliberately - a consumer who will not take it simply does not
         install this package. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Toamaisutaa.PasswordHashing.Argon2.Tests" />
  </ItemGroup>
</Project>
