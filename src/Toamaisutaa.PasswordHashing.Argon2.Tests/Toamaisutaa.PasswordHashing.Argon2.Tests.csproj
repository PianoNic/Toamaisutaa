<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!-- Referenced by the tests as well as by the package, so a hash can be derived here without
         going through the class under test. A test that takes its expectation from the code it is
         testing agrees with that code even when it is wrong. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <!-- The container itself, not just its abstractions: what the registration tests assert is that
         resolving IPasswordHasher out of a real provider gets the Argon2 one, whichever order the
         two Add calls ran in. Test project only. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- A real IConfiguration for the overload the docs and the sample use, for the same reason:
         the binding is what those tests are about, so it has to be the actual one. Test project
         only - the package itself needs nothing beyond the abstractions. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toamaisutaa.PasswordHashing.Argon2\Toamaisutaa.PasswordHashing.Argon2.csproj" />
  </ItemGroup>

</Project>
