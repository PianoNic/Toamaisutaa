<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!-- Runs the real pipeline in-process: routing, authentication, authorization, endpoint
         filters. A stub over the handlers would have passed for all three bugs this suite exists
         to catch, because every one of them was correct until it reached the wire. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Same reason as the SQLite migrations package: Microsoft.EntityFrameworkCore.Sqlite pulls in
         SQLitePCLRaw.lib.e_sqlite3 2.1.11, which carries GHSA-2m69-gcr7-jv3q. Named here to force
         the patched version rather than build with a known advisory. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <!-- MapOpenApi is called directly by the harness, so the document under test is generated by
         the same code path an application uses. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toamaisutaa.AspNetCore\Toamaisutaa.AspNetCore.csproj" />
    <ProjectReference Include="..\Toamaisutaa.OpenApi\Toamaisutaa.OpenApi.csproj" />
    <ProjectReference Include="..\Toamaisutaa.OpenIdConnect\Toamaisutaa.OpenIdConnect.csproj" />
    <ProjectReference Include="..\Toamaisutaa.EntityFrameworkCore\Toamaisutaa.EntityFrameworkCore.csproj" />
    <!-- An opt-in package, exercised here because what it changes - which hasher the host resolves,
         and what a login writes back - is invisible from every response body. -->
    <ProjectReference Include="..\Toamaisutaa.PasswordHashing.Argon2\Toamaisutaa.PasswordHashing.Argon2.csproj" />
    <!-- An opt-in package, exercised here because what it changes is the body of /auth/register and
         /auth/password, and a validator that reaches the wire correctly in a unit test is exactly
         the shape of bug this suite exists for. -->
    <ProjectReference Include="..\Toamaisutaa.PasswordValidation.Hibp\Toamaisutaa.PasswordValidation.Hibp.csproj" />
    <!-- An opt-in package, exercised here because a WebAuthn ceremony cannot be checked anywhere
         else: there is no browser and no physical key, and a service-level test of one would be the
         package agreeing with itself about bytes it produced. -->
    <ProjectReference Include="..\Toamaisutaa.Passkeys\Toamaisutaa.Passkeys.csproj" />
  </ItemGroup>

</Project>
