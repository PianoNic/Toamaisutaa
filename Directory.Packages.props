<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive pinning is deliberately OFF. It works, but it publishes every pinned transitive
         package as a direct dependency of ours, so the gallery would show Toamaisutaa.EntityFrameworkCore
         depending on four Microsoft.Extensions packages it never references. Where a transitive
         version genuinely has to be forced, the project references it explicitly and says why. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <!-- Oracle's provider rather than Pomelo, which is the usual community pick: Pomelo has no EF
         Core 10 release and its latest, 9.0.0, pins Microsoft.EntityFrameworkCore.Relational to
         [9.0.0, 9.0.999], so it cannot coexist with the rest of this solution. Swap it when Pomelo
         ships for EF 10 - it is a provider package and a regenerated migration, nothing more. -->
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.9" />
    <!-- Ships out of dotnet/extensions, which numbers its own line - 10.10.0 is the current build
         of the .NET 10 branch, not a major ahead of the 10.0.10 packages below. -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Transitive pin: Microsoft.EntityFrameworkCore.Sqlite drags in SQLitePCLRaw.lib.e_sqlite3
         2.1.11, which carries GHSA-2m69-gcr7-jv3q. 2.1.12 is the patch on the same line. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Transitive pin: Microsoft.AspNetCore.OpenApi 10.0.10 drags in Microsoft.OpenApi 2.0.0,
         which carries GHSA-v5pm-xwqc-g5wc. 2.11.0 is the same major, so no API change. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.18" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />
    <PackageVersion Include="TUnit" Version="0.90.0" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <!-- The only .NET Argon2 that is pure managed, ships no native assets and passes the RFC 9106
         vectors. Isopoh is the better-engineered one and already targets net10 on master, but its
         published release is still 2.0.0 from 2023 - swap when that changes, and the PHC format
         means it is a one-file change. -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- fido2-net-lib. .NET 10 does ship WebAuthn, but only inside ASP.NET Core Identity, bound to
         that library's user manager and stores - so a package that is not Identity cannot reuse it.
         This is the established standalone implementation: MIT, maintained, and what every other
         non-Identity WebAuthn integration in .NET is built on. 4.0.1 is the current stable line;
         5.0.0 is still in preview. -->
    <PackageVersion Include="Fido2" Version="4.0.1" />
  </ItemGroup>

</Project>
